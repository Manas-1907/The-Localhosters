PORT=4000
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/mama
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# 32 bytes as 64 hex chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=
# Used from Phase 3 onward
GEMINI_API_KEY=
# Model name can be changed without code edits
GEMINI_MODEL=gemini-2.5-flash

# Push reminders. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Speech to text provider
STT_PROVIDER=gemini

# Email for Support Circle invites and nudges (optional but needed for real emails).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MAMA <you@gmail.com>

# --- Public site / contact form ---
# Set NODE_ENV=production in production: redirects HTTP -> HTTPS and sends HSTS.
NODE_ENV=development
# Override the HTTPS redirect (true/false). Defaults to true in production.
FORCE_HTTPS=
# Where contact-form messages are emailed (needs the SMTP settings above). Messages are always saved to the database.
CONTACT_TO_EMAIL=
# Optional extra spam protection (Cloudflare Turnstile). Also set turnstileSiteKey in client/assets/site.js.
TURNSTILE_SECRET_KEY=
